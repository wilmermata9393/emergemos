{
  "expo": {
    "name": "Mi Salud",
    "slug": "rme-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "misalud",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.rme.misalud"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "http://192.168.1.100:4000/api"
    }
  }
}
