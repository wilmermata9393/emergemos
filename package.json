{
  "name": "record-medico-electronico",
  "version": "0.1.0",
  "private": true,
  "description": "Récord Médico Electrónico (EMR) — plataforma clínica con soporte para controles HIPAA",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "ts-node packages/database/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "api:dev": "npm run start:dev --workspace @rme/api",
    "api:build": "npm run build --workspace @rme/api",
    "web:dev": "npm run dev --workspace @rme/web",
    "web:build": "npm run build --workspace @rme/web",
    "api:build:prod": "npm run db:generate && npm run api:build",
    "start:prod": "npm run db:deploy && (npm run db:seed || true) && node apps/api/dist/main.js",
    "web:start": "npm run start --workspace @rme/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "web-push": "^3.6.7"
  }
}
