# ==========================================================================
#  ARCHIVO DE EJEMPLO — copia este archivo a ".env" y rellena los valores.
#  NUNCA subas el archivo .env real a git (ya está en .gitignore).
# ==========================================================================

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BASE_DE_DATOS
# Ejemplo local (PostgreSQL instalado en tu computadora):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rme?schema=public"

# --- Seguridad / Autenticación ---
# Secreto para firmar los tokens de sesión (JWT).
# Genera uno seguro con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIA_ESTO_por_un_valor_largo_y_aleatorio"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Clave para el cifrado de campos sensibles en la base de datos (AES-256).
# Debe ser exactamente 64 caracteres hex (32 bytes). Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY="CAMBIA_ESTO_64_caracteres_hexadecimales"

# Cierre de sesión automático por inactividad (requisito HIPAA), en minutos.
SESSION_IDLE_TIMEOUT_MINUTES="15"

# --- Servidor API ---
API_PORT="4000"
NODE_ENV="development"

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS="http://localhost:3000"

# Carpeta donde se guardan los archivos cifrados (fuera del repositorio).
# En producción, usar almacenamiento de objetos con BAA (ej. S3).
STORAGE_DIR="./storage"
